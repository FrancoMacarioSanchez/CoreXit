# Copiar a .env y completar
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://hub.corexit.tech

# Base de datos (docker-compose levanta PostgreSQL en el 5433)
DB_NAME=corex_db
DB_USER=corex_user
DB_PASSWORD=corex_password
DB_HOST=127.0.0.1
DB_PORT=5433
# DB_ENGINE=sqlite   # para probar rápido sin PostgreSQL

# Integración con los SaaS
COREX_HUB_URL=http://127.0.0.1:8000
COREX_DOMINIO_BASE=corexit.tech
COREX_SAAS_TIMEOUT=10
